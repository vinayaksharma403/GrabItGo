# ==============================================================================
# GrabItGo Environment Configuration Template
# Copy this file to .env in root or corresponding server/client directories.
# NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# --- Server Configuration ---
PORT=8050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/grabitgo
FRONTEND_URL=http://localhost:5173

# --- Authentication (JWT) ---
SECRET_KEY_ACCESS_TOKEN=your_jwt_access_secret_key_here
SECRET_KEY_REFRESH_TOKEN=your_jwt_refresh_secret_key_here

# --- Cloudinary (Media Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET_KEY=your_cloudinary_api_secret

# --- Resend (Email Service) ---
RESEND_API=re_your_resend_api_key_here

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=inr

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8050
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key
