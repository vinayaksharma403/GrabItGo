# ==============================================================================
# GrabItGo Server Environment Configuration Template
# Copy this file to server/.env and fill in required values.
# ==============================================================================

PORT=8050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/grabitgo
FRONTEND_URL=http://localhost:5173

SECRET_KEY_ACCESS_TOKEN=your_jwt_access_secret_key_here
SECRET_KEY_REFRESH_TOKEN=your_jwt_refresh_secret_key_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET_KEY=your_cloudinary_api_secret

RESEND_API=re_your_resend_api_key_here

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=inr
